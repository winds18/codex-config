{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/codex-policy-guard.py\"",
            "timeout": 10,
            "statusMessage": "恢复压缩后的项目控制上下文"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/codex-policy-guard.py\"",
            "timeout": 10,
            "statusMessage": "加载子代理交付约束"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/codex-policy-guard.py\"",
            "timeout": 10,
            "statusMessage": "检查提示词安全策略"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/codex-policy-guard.py\"",
            "timeout": 10,
            "statusMessage": "检查工具执行策略"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/codex-policy-guard.py\"",
            "timeout": 10,
            "statusMessage": "检查权限升级策略"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/codex-policy-guard.py\"",
            "timeout": 10,
            "statusMessage": "检查完成声明与验证证据"
          }
        ]
      }
    ]
  }
}
