{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/codex-policy-guard.py\"",
            "timeout": 10,
            "statusMessage": "检查直接命令与受管文件目标"
          }
        ]
      }
    ]
  }
}
